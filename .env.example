# Copy this file to .env and replace the placeholder with a unique password.
POSTGRES_DB=mhw_db
POSTGRES_USER=mhw_user
POSTGRES_PASSWORD=replace-with-a-long-unique-url-safe-password
DB_MEMBER_USER=mhw_member
DB_MEMBER_PASSWORD=replace-with-another-long-unique-url-safe-password
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=0.0.0.0

# For Python running on this computer. Teammates replace localhost with this
# computer's private LAN IP address (for example, 192.168.x.x).
DATABASE_URL=postgresql+psycopg2://mhw_member:replace-with-another-long-unique-url-safe-password@localhost:5432/mhw_db
